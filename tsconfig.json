{
  "compilerOptions": {
    "target": "ESNext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
  },
  "include": [
    "src/**/*",
    "vite/**/*",
    "*.ts",
    "*.mts",
    "vite/vite.renderer.config.mts",
    "vite/vite.preload.config.mts",
    "vite/vite.main.config.mts"
  ]
}